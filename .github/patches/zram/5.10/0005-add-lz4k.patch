+uint8_t *lz4k_out_repeat(
+	uint8_t *out_at,
+	uint8_t *const out_end,
+	uint_fast32_t utag,
+	uint_fast32_t r_bytes_max,
+	const uint_fast32_t nr_log2,
+	const uint_fast32_t off_log2,
+	const bool check_out)
+{
