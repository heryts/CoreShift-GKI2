diff --git a/crypto/Kconfig b/crypto/Kconfig
index 258b4cc..64b9c44 100644
--- a/crypto/Kconfig
+++ b/crypto/Kconfig
@@ -1817,6 +1817,15 @@ config CRYPTO_LZ4
 	help
 	  This is the LZ4 algorithm.
 
+config CRYPTO_LZ4K
+	tristate "LZ4K"
