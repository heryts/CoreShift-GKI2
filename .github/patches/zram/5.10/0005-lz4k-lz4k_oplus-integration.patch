diff --git a/drivers/block/zram/Kconfig b/drivers/block/zram/Kconfig
index 9dd2627..b9c4c0f 100644
--- a/drivers/block/zram/Kconfig
+++ b/drivers/block/zram/Kconfig
@@ -29,6 +29,42 @@ config ZRAM_DEF_COMP_LZO_RLE
 	help
 	  LZO-RLE compression (the historical default).
 
+config ZRAM_DEF_COMP_ZSTD
+	bool "zstd"
+	select CRYPTO_ZSTD
+	help
+	  ZSTD compression.
+
+config ZRAM_DEF_COMP_LZ4
+	bool "lz4"
+	select CRYPTO_LZ4
+	help
+	  LZ4 compression.
+
+config ZRAM_DEF_COMP_LZ4HC
+	bool "lz4hc"
+	select CRYPTO_LZ4HC
+	help
+	  LZ4HC compression.
+
+config ZRAM_DEF_COMP_842
+	bool "842"
+	select CRYPTO_842
+	help
+	  842 compression.
+
+config ZRAM_DEF_COMP_LZ4K
+	bool "lz4k"
+	select CRYPTO_LZ4K
+	help
+	  SukiSU LZ4K compression.
+
+config ZRAM_DEF_COMP_LZ4K_OPLUS
+	bool "lz4k_oplus"
+	select CRYPTO_LZ4K_OPLUS
+	help
+	  SukiSU LZ4K_OPLUS compression.
+
 config ZRAM_DEF_COMP_LZ4KD
 	bool "lz4kd"
 	select CRYPTO_LZ4KD
@@ -47,6 +83,12 @@ config ZRAM_DEF_COMP
 	string
 	depends on ZRAM
 	default "lzo-rle" if ZRAM_DEF_COMP_LZO_RLE
+	default "zstd" if ZRAM_DEF_COMP_ZSTD
+	default "lz4" if ZRAM_DEF_COMP_LZ4
+	default "lz4hc" if ZRAM_DEF_COMP_LZ4HC
+	default "842" if ZRAM_DEF_COMP_842
+	default "lz4k" if ZRAM_DEF_COMP_LZ4K
+	default "lz4k_oplus" if ZRAM_DEF_COMP_LZ4K_OPLUS
 	default "lz4kd" if ZRAM_DEF_COMP_LZ4KD
 	default "lz4kdr" if ZRAM_DEF_COMP_LZ4KDR
 	default "lzo-rle"
