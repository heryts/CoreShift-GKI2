<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- IMPORTANT: do NOT remove kernel/common here, even though
       maintained/custom builds replace it right after sync. The
       sync-kernel action checks that kernel/common's directory
       exists *before* replace-common-source ever runs, and will
       hard-fail with "kernel/common project source path was not
       found" if this project is missing. Let it sync (it's cheap,
       shallow, single repo) and let replace-common-source overwrite
       it afterwards. -->

  <!-- Not required for the Kleaf common:kernel_aarch64_dist target. -->
  <remove-project
    name="kernel/common-modules/wonder"
    path="common-modules/wonder"
  />
  <remove-project
    name="kernel/common-modules/trusty"
    path="common-modules/trusty"
  />
  <remove-project
    name="platform/external/virtio-media"
    path="common-modules/virtio-media"
  />
  <remove-project
    name="kernel/common-modules/virtual-device"
    path="common-modules/virtual-device"
  />
  <remove-project name="platform/external/ltp" path="test/ltp" />
  <remove-project
    name="platform/prebuilts/clang/host/linux-x86"
    path="prebuilts/clang/host/linux-x86"
  />

  <!-- GBL-specific dependencies are not used by this CI build path. -->
  <remove-project
    name="platform/bootable/libbootloader"
    path="bootable/libbootloader"
  />
  <remove-project name="platform/bootable/recovery" path="bootable/recovery" />
  <remove-project
    name="platform/external/arm-trusted-firmware"
    path="external/arm-trusted-firmware"
  />
  <remove-project name="platform/external/avb" path="external/avb" />
  <remove-project name="platform/external/boringssl" path="external/boringssl" />
  <remove-project
    name="platform/external/compiler-rt"
    path="external/compiler-rt"
  />
  <remove-project name="platform/external/dtc" path="external/dtc" />
  <remove-project name="platform/system/libufdt" path="external/libufdt" />
  <remove-project name="platform/external/open-dice" path="external/open-dice" />
  <remove-project name="platform/external/elfutils" path="external/elfutils" />
  <remove-project
    name="platform/external/googletest"
    path="external/googletest"
  />
  <remove-project
    name="platform/external/rust/android-crates-io"
    path="external/rust/android-crates-io"
  />
  <remove-project
    name="platform/external/rust/crates/smoltcp"
    path="external/rust/crates/smoltcp"
  />
  <remove-project
    name="platform/external/rust/crates/zune-inflate"
    path="external/rust/crates/zune-inflate"
  />
  <remove-project
    name="platform/prebuilts/fuchsia_sdk"
    path="prebuilts/fuchsia_sdk"
  />
  <remove-project name="platform/system/core" path="system/core" />

  <!-- Extra toolchain projects: only needed if kernel/build or the
       common-modules actually compile Rust/NDK-based components, or
       if you build the legacy GCC-based binutils path. If your build
       is Clang-only with no Rust kernel config enabled, these are
       safe to drop. Test one at a time. -->
  <remove-project name="platform/prebuilts/rust" path="prebuilts/rust" />
  <remove-project name="toolchain/prebuilts/ndk/r26" path="prebuilts/ndk-r26" />
  <remove-project name="platform/prebuilts/jdk/jdk11" path="prebuilts/jdk/jdk11" />
  <remove-project
    name="platform/prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8"
    path="prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8"
  />

  <!-- Small utility libs, unlikely to be needed for kernel_aarch64_dist. -->
  <remove-project name="platform/external/libcap" path="external/libcap" />
  <remove-project name="platform/external/libcap-ng" path="external/libcap-ng" />

  <!-- Only needed if you build the host toolchain from source instead
       of using the prebuilt clang above. -->
  <remove-project name="platform/external/lz4" path="external/lz4" />
  <remove-project name="platform/external/pigz" path="external/pigz" />
  <remove-project name="platform/external/toybox" path="external/toybox" />
  <remove-project name="platform/external/zlib" path="external/zlib" />
  <remove-project name="platform/external/zopfli" path="external/zopfli" />

  <!-- bzlmod/Bazel Central Registry local overrides used by
       kernel/build's MODULE.bazel for hermetic builds. If your build
       has internet access at build time (GitHub Actions usually
       does), Bazel can normally resolve these from bcr.bazel.build
       directly instead of needing the local checkout. If the Bazel
       build starts failing to resolve one of these external repos,
       re-comment just that line. -->
  <remove-project name="platform/external/bazel-contrib-bazel_features" path="external/bazel-contrib-bazel_features" />
  <remove-project name="platform/external/bazel-skylib" path="external/bazel-skylib" />
  <remove-project name="platform/external/bazelbuild-bazel-central-registry" path="external/bazelbuild-bazel-central-registry" />
  <remove-project name="platform/external/bazelbuild-platforms" path="external/bazelbuild-platforms" />
  <remove-project name="platform/external/bazelbuild-rules_cc" path="external/bazelbuild-rules_cc" />
  <remove-project name="platform/external/bazelbuild-rules_license" path="external/bazelbuild-rules_license" />
  <remove-project name="platform/external/bazelbuild-rules_pkg" path="external/bazelbuild-rules_pkg" />
  <remove-project name="platform/external/bazelbuild-rules_python" path="external/bazelbuild-rules_python" />
  <remove-project name="platform/external/bazelbuild-rules_rust" path="external/bazelbuild-rules_rust" />
  <remove-project name="platform/external/bazelbuild-rules_shell" path="external/bazelbuild-rules_shell" />
  <remove-project name="platform/external/python/absl-py" path="external/python/absl-py" />

  <!-- NEXT TIER - test one at a time, in this order, re-running the
       build after each: -->

  <!-- Lower risk: clang-tidy/clang-format/static-analysis tools.
       Only needed if kernel/build's Bazel rules explicitly invoke
       clang-tidy or similar during the dist build. -->
  <remove-project name="platform/prebuilts/clang-tools" path="prebuilts/clang-tools" />

  <!-- HIGHEST RISK - test LAST: general Android platform host tools
       (soong_zip and friends). Some Kleaf dist/packaging rules do
       reference binaries from this prebuilt, so removing it is the
       most likely of everything on this page to break the build.
       Uncomment only after everything else above is confirmed
       working, and be ready to revert if `tools/bazel build
       //common:kernel_aarch64_dist` starts failing on a missing tool. -->
  <!--
  <remove-project name="platform/prebuilts/build-tools" path="prebuilts/build-tools" />
  -->
</manifest>
